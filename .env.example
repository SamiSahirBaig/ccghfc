# ==============================================================================
# CityClean Civic Issue Reporting Platform - Environment Configuration
# ==============================================================================

NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
WEB_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Database (PostgreSQL 15 with PostGIS extension)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cityclean?schema=public

# ------------------------------------------------------------------------------
# Redis & BullMQ Queue System
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# Authentication (JWT)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=cityclean_super_secret_access_jwt_key_2026_production
JWT_REFRESH_SECRET=cityclean_super_secret_refresh_jwt_key_2026_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ------------------------------------------------------------------------------
# Object Storage (S3 / MinIO)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local # 'local', 'minio', or 's3'
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cityclean-media

# ------------------------------------------------------------------------------
# Email / SMTP (Mailpit in development)
# ------------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="CityClean Civic Redressal" <no-reply@cityclean.gov>
DM_OFFICE_EMAIL=dm-office@district.gov.in
STATE_OVERSIGHT_EMAIL=commissioner@civic.state.gov.in

# ------------------------------------------------------------------------------
# AI Vision Verification & Ranking
# ------------------------------------------------------------------------------
# Options: 'mock', 'gemini', 'claude'
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# SLA & Escalation Settings
# ------------------------------------------------------------------------------
# Set to e.g. 2 to test 2-minute SLA cycle during demos and tests, or leave 0 for 72h default
SLA_OVERRIDE_MINUTES=0
DEFAULT_SLA_HOURS=72

# ------------------------------------------------------------------------------
# Hardware / IoT Ingestion Security
# ------------------------------------------------------------------------------
ENABLE_DEVICE_HMAC=false
DEVICE_CLOCK_SKEW_TOLERANCE_SECONDS=300
